{
  "name": "e2e-playwright",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/e2e-playwright/tests",
  "projectType": "application",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": [
        {
          "projects": ["mcp-server", "chrome-extension", "override-next-fixture"],
          "target": "build",
          "params": "ignore"
        }
      ],
      "options": {
        "command": "pnpm exec playwright test -c apps/e2e-playwright/playwright.config.ts"
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": [
        {
          "projects": ["mcp-server", "chrome-extension"],
          "target": "build",
          "params": "ignore"
        }
      ],
      "options": {
        "command": "pnpm exec playwright test -c apps/e2e-playwright/playwright.config.ts --grep @smoke"
      }
    },
    "full": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": [
        {
          "projects": ["mcp-server", "chrome-extension", "override-next-fixture"],
          "target": "build",
          "params": "ignore"
        }
      ],
      "options": {
        "command": "pnpm exec playwright test -c apps/e2e-playwright/playwright.config.ts --grep @full"
      }
    }
  },
  "tags": ["app", "e2e"]
}
